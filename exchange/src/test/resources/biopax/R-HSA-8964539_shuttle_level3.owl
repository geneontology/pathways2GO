 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">H2O + L-glutamate + NAD(+) =&gt; 2-oxoglutarate + H(+) + NADH + NH4(+)</bp:displayName>
 <bp:right rdf:resource="#SmallMolecule419" />
