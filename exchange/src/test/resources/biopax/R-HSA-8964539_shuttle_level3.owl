<bp:Pathway rdf:ID="Pathway473">
 <bp:pathwayOrder rdf:resource="#PathwayStep4109" />
 <bp:pathwayOrder rdf:resource="#PathwayStep4108" />
 <bp:pathwayOrder rdf:resource="#PathwayStep4107" />
 <bp:pathwayOrder rdf:resource="#PathwayStep4106" />
 <bp:pathwayOrder rdf:resource="#PathwayStep4105" />
