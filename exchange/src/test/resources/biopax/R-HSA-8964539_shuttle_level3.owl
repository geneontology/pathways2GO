 <bp:title rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Pathogenesis and pathophysiology of citrin (a mitochondrial aspartate glutamate carrier) deficiency</bp:title>
 <bp:db rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
