<bp:BiochemicalReaction rdf:ID="BiochemicalReaction4023">
 <bp:participantStoichiometry rdf:resource="#Stoichiometry10804" />
 <bp:xref rdf:resource="#UnificationXref50541" />
 <bp:xref rdf:resource="#PublicationXref10177" />
 <bp:xref rdf:resource="#PublicationXref10176" />
 <bp:xref rdf:resource="#UnificationXref50540" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">(S)-1-pyrroline-5-carboxylate + NADPH + H+ =&gt; L-Pro + NADP+</bp:displayName>
 <bp:right rdf:resource="#SmallMolecule310" />
 <bp:right rdf:resource="#SmallMolecule2479" />
 <bp:eCNumber rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.5.1.2</bp:eCNumber>
 <bp:left rdf:resource="#SmallMolecule261" />
 <bp:left rdf:resource="#SmallMolecule2478" />
 <bp:left rdf:resource="#SmallMolecule305" />
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">PYCR3 decamer reduces (S)-1-pyrroline-5-carboxylate to L-Pro</bp:name>
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1-pyrroline-5-carboxylate + 2 H(+) + NADPH =&gt; L-proline + NADP(+)</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Authored: D&apos;Eustachio, Peter, 2015-06-17</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Edited: D&apos;Eustachio, Peter, 2015-06-17</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Reviewed: Jassal, Bijay, 2015-08-13</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Cytosolic pyrroline-5-carboxylate reductase 3 (PYCR3) (also known as Pyrroline-5-carboxylate reductase-like (PYCRL)) catalyzes the reaction of (S)-1-pyrroline-5-carboxylate with NADPH + H+ to form proline and NADP+ (De Ingeniis et al. 2012). Distinct roles have been suggested for PYCR3 versus PYCR1 and 2 enzymes in proline synthesis in melanoma cell lines (De Ingeniis et al. 2012); the physiological role of PYCR3 in normal tissue is less clear.</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Reviewed: D&apos;Eustachio, Peter, 2024-11-08</bp:comment>
 <bp:dataSource rdf:resource="#Provenance1" />
 <bp:conversionDirection rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">LEFT_TO_RIGHT</bp:conversionDirection>
</bp:BiochemicalReaction>

