 <bp:source rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Biochem J 270:651-7</bp:source>
 <bp:title rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">The amino acid sequence of cytosolic aspartate aminotransferase from human liver</bp:title>
