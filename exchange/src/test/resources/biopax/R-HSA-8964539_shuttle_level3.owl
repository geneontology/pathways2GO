<bp:BiochemicalReaction rdf:ID="BiochemicalReaction4021">
 <bp:participantStoichiometry rdf:resource="#Stoichiometry10800" />
 <bp:xref rdf:resource="#UnificationXref50522" />
 <bp:xref rdf:resource="#PublicationXref10175" />
 <bp:xref rdf:resource="#UnificationXref50523" />
 <bp:xref rdf:resource="#PublicationXref10176" />
 <bp:xref rdf:resource="#PublicationXref10174" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">PYCR1 decamer reduces (S)-1-pyrroline-5-carboxylate to L-Pro</bp:displayName>
 <bp:right rdf:resource="#SmallMolecule2477" />
 <bp:right rdf:resource="#SmallMolecule951" />
 <bp:eCNumber rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1.5.1.2</bp:eCNumber>
 <bp:left rdf:resource="#SmallMolecule416" />
 <bp:left rdf:resource="#SmallMolecule2476" />
 <bp:left rdf:resource="#SmallMolecule952" />
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">1-pyrroline-5-carboxylate + 2 H(+) + NADH =&gt; L-proline + NAD(+)</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Pyrroline-5-carboxylate reductase 1 (PYCR1) catalyzes the reaction of (S)-1-pyrroline-5-carboxylate with NADH + H+ to form proline and NAD+ (De Ingeniis et al. 2012). The active enzyme is a homodecamer (Meng et al. 2006). Subcellular fractionation (De Ingeniis et al. 2012) and co-localization studies (Reversade et al. 2009) indicate that PYCR1 is mitochondrial. The enzyme’s higher reaction rate with NADH than NADPH as cofactor, and its competitive inhibition by the product proline suggest that its main physiological function is production of proline (Meng et al. 2006). Its deficiency is associated with cutis laxa (Reversade et al. 2009).</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Reviewed: D&apos;Eustachio, Peter, 2024-11-08</bp:comment>
 <bp:dataSource rdf:resource="#Provenance1" />
 <bp:conversionDirection rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">LEFT_TO_RIGHT</bp:conversionDirection>
</bp:BiochemicalReaction>

<bp:BiochemicalReaction rdf:ID="BiochemicalReaction4020">
 <bp:xref rdf:resource="#UnificationXref50513" />
 <bp:xref rdf:resource="#UnificationXref50512" />
 <bp:xref rdf:resource="#PublicationXref10170" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">L-glutamate gamma-semialdehyde &lt;=&gt; L-1-pyrroline-5-carboxylate</bp:displayName>
 <bp:right rdf:resource="#SmallMolecule739" />
 <bp:right rdf:resource="#SmallMolecule416" />
 <bp:right rdf:resource="#SmallMolecule2476" />
 <bp:left rdf:resource="#SmallMolecule2474" />
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">L-glutamate 5-semialdehyde =&gt; (S)-1-pyrroline-5-carboxylate + H(+) + H2O</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">The interconversion of glutamate 5-semialdehyde (L-GluSS) and (S)-1-pyrroline-5-carboxylate (1PYR-5COOH) is a spontaneous reaction (Scriver et al. 2001).</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Reviewed: D&apos;Eustachio, Peter, 2024-11-08</bp:comment>
 <bp:dataSource rdf:resource="#Provenance1" />
 <bp:conversionDirection rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">LEFT_TO_RIGHT</bp:conversionDirection>
</bp:BiochemicalReaction>

