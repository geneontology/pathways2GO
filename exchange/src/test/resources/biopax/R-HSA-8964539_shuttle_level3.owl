<bp:BiochemicalReaction rdf:ID="BiochemicalReaction4019">
 <bp:xref rdf:resource="#PublicationXref10173" />
 <bp:xref rdf:resource="#UnificationXref50508" />
 <bp:xref rdf:resource="#UnificationXref50507" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ATP + H(+) + L-glutamate + NADPH =&gt; ADP + L-glutamate 5-semialdehyde + NADP(+) + phosphate</bp:displayName>
 <bp:right rdf:resource="#SmallMolecule415" />
 <bp:right rdf:resource="#SmallMolecule736" />
 <bp:right rdf:resource="#SmallMolecule2474" />
 <bp:right rdf:resource="#SmallMolecule414" />
 <bp:left rdf:resource="#SmallMolecule420" />
 <bp:left rdf:resource="#SmallMolecule734" />
 <bp:left rdf:resource="#SmallMolecule416" />
 <bp:left rdf:resource="#SmallMolecule412" />
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">glutamate + ATP + NADPH + H+ =&gt; L-glutamate gamma-semialdehyde + NADP+ + ADP + orthophosphate [P5CS]</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Edited: D&apos;Eustachio, P, 2010-02-18</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Authored: D&apos;Eustachio, P, 2010-02-18</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Reviewed: Jassal, Bijay, 2010-02-26</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Delta-1-pyrroline-5-carboxylate synthetase associated with the inner mitochondrial membrane catalyzes the two-step reaction that converts glutamate, ATP, and NADPH + H+ to L-glutamate gamma-semialdehyde, NADP+, ADP, and orthophosphate. Two P5CS isoforms have been identified; both are active when expressed in enzyme-deficient cells in culture (Hu et al. 1999). Unpublished crystallographic data (PDB 2H5G) indicate that the enzyme is a dimer.</bp:comment>
 <bp:dataSource rdf:resource="#Provenance1" />
 <bp:conversionDirection rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">LEFT_TO_RIGHT</bp:conversionDirection>
</bp:BiochemicalReaction>

<bp:BiochemicalReaction rdf:ID="BiochemicalReaction4018">
 <bp:xref rdf:resource="#PublicationXref10169" />
 <bp:xref rdf:resource="#PublicationXref10171" />
 <bp:xref rdf:resource="#PublicationXref10172" />
 <bp:xref rdf:resource="#PublicationXref10170" />
 <bp:xref rdf:resource="#UnificationXref50494" />
 <bp:xref rdf:resource="#UnificationXref50493" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2-oxoglutarate + L-ornithine =&gt; L-glutamate + L-glutamate 5-semialdehyde</bp:displayName>
 <bp:right rdf:resource="#SmallMolecule420" />
 <bp:right rdf:resource="#SmallMolecule2474" />
 <bp:eCNumber rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.6.1.13</bp:eCNumber>
 <bp:left rdf:resource="#SmallMolecule419" />
 <bp:left rdf:resource="#SmallMolecule2475" />
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ornithine + alpha-ketoglutarate &lt;=&gt; glutamate + L-glutamate gamma-semialdehyde [OAT]</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Mitochondrial ornithine aminotransferase (OAT) catalyzes the reversible reaction of ornithine and alpha-ketoglutarate to form glutamate semialdehyde and glutamate (Ohura et al. 1982). The active enzyme is a hexamer (Shen et al. 1998). Inherited OAT deficiency leads to ornithine accumulation in vivo and gyrate atrophy of the choroid and retina (Brody et al. 1992; Valle and Simell 2001).</bp:comment>
 <bp:dataSource rdf:resource="#Provenance1" />
 <bp:conversionDirection rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">LEFT_TO_RIGHT</bp:conversionDirection>
</bp:BiochemicalReaction>

<bp:BiochemicalReaction rdf:ID="BiochemicalReaction4017">
 <bp:xref rdf:resource="#PublicationXref10169" />
 <bp:xref rdf:resource="#UnificationXref50492" />
 <bp:xref rdf:resource="#PublicationXref10170" />
 <bp:xref rdf:resource="#UnificationXref50491" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">L-glutamate + L-glutamate 5-semialdehyde =&gt; 2-oxoglutarate + L-ornithine</bp:displayName>
 <bp:right rdf:resource="#SmallMolecule419" />
 <bp:right rdf:resource="#SmallMolecule2475" />
 <bp:eCNumber rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">2.6.1.13</bp:eCNumber>
 <bp:left rdf:resource="#SmallMolecule420" />
 <bp:left rdf:resource="#SmallMolecule2474" />
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">glutamate + L-glutamate gamma-semialdehyde &lt;=&gt; ornithine + alpha-ketoglutarate [OAT]</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Mitochondrial ornithine aminotransferase (OAT) catalyzes the reversible reaction of glutamate semialdehyde and glutamate to form ornithine and alpha-ketoglutarate (Ohura et al. 1982). The active enzyme is a hexamer (Shen et al. 1998). Inherited OAT deficiency leads to ornithine accumulation in vivo and gyrate atrophy of the choroid and retina (Brody et al. 1992; Vallee and Simell 2001).</bp:comment>
 <bp:dataSource rdf:resource="#Provenance1" />
 <bp:conversionDirection rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">LEFT_TO_RIGHT</bp:conversionDirection>
</bp:BiochemicalReaction>

