<bp:BiochemicalReaction rdf:ID="BiochemicalReaction4027">
 <bp:xref rdf:resource="#UnificationXref50596" />
 <bp:xref rdf:resource="#PublicationXref10186" />
 <bp:xref rdf:resource="#PublicationXref10185" />
 <bp:xref rdf:resource="#UnificationXref50595" />
 <bp:displayName rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">glutamate + NH4+ + ATP =&gt; glutamine + ADP + orthophosphate [GLUL]</bp:displayName>
 <bp:right rdf:resource="#SmallMolecule11" />
 <bp:right rdf:resource="#SmallMolecule261" />
 <bp:right rdf:resource="#SmallMolecule6" />
 <bp:right rdf:resource="#SmallMolecule1995" />
 <bp:eCNumber rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">6.3.1.2</bp:eCNumber>
 <bp:left rdf:resource="#SmallMolecule849" />
 <bp:left rdf:resource="#SmallMolecule10" />
 <bp:left rdf:resource="#SmallMolecule446" />
 <bp:name rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">ATP + L-glutamate + NH4(+) =&gt; ADP + H(+) + L-glutamine + phosphate</bp:name>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Cytosolic glutamine synthetase (glutamate-ammonia ligase - GLUL) catalyzes the reaction of glutamate, ammonia, and ATP to form glutamine, ADP, and orthophosphate. The enzyme is a decamer (Krajewski et al. 2008). Mutations in the gene encoding GLUL cause glutamine deficiency in vivo (Haberle et al. 2005).</bp:comment>
 <bp:comment rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">Reviewed: D&apos;Eustachio, Peter, 2024-11-08</bp:comment>
 <bp:dataSource rdf:resource="#Provenance1" />
 <bp:conversionDirection rdf:datatype = "http://www.w3.org/2001/XMLSchema#string">LEFT_TO_RIGHT</bp:conversionDirection>
</bp:BiochemicalReaction>

