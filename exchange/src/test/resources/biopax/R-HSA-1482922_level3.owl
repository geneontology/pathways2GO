  <bp:Protein rdf:ID="Protein14">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLA2G2E</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Group IIE secretory phospholipase A2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sPLA2-IIE</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference12" />
    <bp:feature rdf:resource="#FragmentFeature13" />
