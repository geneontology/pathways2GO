  <bp:Protein rdf:ID="Protein4">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLA2G16</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Group XVI phospholipase A2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adipose-specific phospholipase A2</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary2" />
    <bp:entityReference rdf:resource="#ProteinReference4" />
    <bp:feature rdf:resource="#FragmentFeature4" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1498803</bp:comment>
