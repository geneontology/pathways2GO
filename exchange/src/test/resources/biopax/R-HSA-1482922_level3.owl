  <bp:Protein rdf:ID="Protein16">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLA2G5</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Calcium-dependent phospholipase A2 precursor</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phosphatidylcholine 2-acylhydrolase</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLA2-10</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Group V phospholipase A2</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference14" />
    <bp:feature rdf:resource="#FragmentFeature15" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 61213</bp:comment>
