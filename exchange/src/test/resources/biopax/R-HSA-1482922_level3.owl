  <bp:Protein rdf:ID="Protein8">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LPIAT</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MBOAT7</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Membrane-bound O-acyltransferase domain-containing protein 7</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lysophosphatidylinositol acyltransferase</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lysophospholipid acyltransferase 7</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LPLAT 7</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference8" />
    <bp:feature rdf:resource="#FragmentFeature8" />
