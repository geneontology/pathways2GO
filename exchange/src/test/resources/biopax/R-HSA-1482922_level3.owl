  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction2">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule1" />
    <bp:left rdf:resource="#SmallMolecule2" />
    <bp:right rdf:resource="#SmallMolecule3" />
    <bp:right rdf:resource="#SmallMolecule4" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.1.1.4</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PI is hydrolyzed to 1-acyl LPI by PLA2[12]</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref54" />
    <bp:xref rdf:resource="#UnificationXref55" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At the endoplasmic reticulum (ER) membrane, phosphatidylinositol (PI) is hydrolyzed, and has one of its acyl chains cleaved off, by membrane-associated phospholipase A2 gamma 2A (PLA2G2A) (Singer et al. 2002) or by cytosolic phospholipase A2 gamma (PLA2G4C) (Ghomashchi et al. 2010), to form 1-acyl lysophosphatidylinositol (LPI).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref4" />
    <bp:xref rdf:resource="#PublicationXref2" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Williams, MG, 2011-09-14</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Williams, MG, 2011-08-12</bp:comment>
  </bp:BiochemicalReaction>
