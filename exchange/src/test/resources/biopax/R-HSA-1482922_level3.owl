  <bp:Protein rdf:ID="Protein13">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SPLASH</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLA2G2D</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Group IID secretory phospholipase A2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sPLA2-IID</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference11" />
    <bp:feature rdf:resource="#FragmentFeature12" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1498804</bp:comment>
    <bp:xref rdf:resource="#UnificationXref101" />
