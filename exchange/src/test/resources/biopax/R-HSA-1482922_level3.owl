  <bp:Protein rdf:ID="Protein7">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLA2G2A</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Group IIA phospholipase A2</bp:name>
