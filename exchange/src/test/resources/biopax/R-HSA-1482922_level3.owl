  <bp:PublicationXref rdf:ID="PublicationXref6">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">18094042</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2008</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caenorhabditis elegans mboa-7, a member of the MBOAT family, is required for selective incorporation of polyunsaturated fatty acids into phosphatidylinositol</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lee, HC</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inoue, T</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Imae, R</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kono, N</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shirae, S</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matsuda, S</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gengyo-Ando, K</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mitani, S</bp:author>
