  <bp:Protein rdf:ID="Protein17">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLA2G10</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Group 10 secretory phospholipase A2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sPLA2-X</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference15" />
    <bp:feature rdf:resource="#FragmentFeature16" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1498793</bp:comment>
