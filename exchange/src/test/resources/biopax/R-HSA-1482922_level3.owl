  <bp:Protein rdf:ID="Protein5">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLBD1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phospholipase B-like 1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary2" />
    <bp:entityReference rdf:resource="#ProteinReference5" />
    <bp:feature rdf:resource="#FragmentFeature5" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1524034</bp:comment>
