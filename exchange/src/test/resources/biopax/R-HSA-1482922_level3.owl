  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction3">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule7" />
    <bp:left rdf:resource="#SmallMolecule4" />
    <bp:right rdf:resource="#SmallMolecule8" />
    <bp:right rdf:resource="#SmallMolecule1" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.3.1.51</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1-acyl LPI is acylated to PI by MBOAT7</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref65" />
    <bp:xref rdf:resource="#UnificationXref66" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At the endoplasmic reticulum (ER) membrane, lysophospholipid acyltransferase 7 (MBOAT7) aka LPIAT acylates 1-acyl lysophosphatidylinositol (LPI) to form phosphatidylinositol (PI) (Gijon et al. 2008, Lee et al. 2008).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref5" />
    <bp:xref rdf:resource="#PublicationXref6" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Williams, MG, 2011-09-14</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Williams, MG, 2011-08-12</bp:comment>
  </bp:BiochemicalReaction>
