    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cytosolic COPRO3 translocates to mitochondrial intermembrane space</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Translocation of coproporphyrinogen III from the cytosol to the mitochondrial intermembrane space</bp:name>
    <bp:xref rdf:resource="#UnificationXref124" />
    <bp:xref rdf:resource="#UnificationXref125" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Coproporpyrinogen III (COPRO3) enters the mitochondrial intermembrane space from the cytosol. It is not known whether this process is facilitated by a transporter (Grandchamp et al. 1978).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref17" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Jassal, B, D'Eustachio, P, 2007-01-24 10:19:49</bp:comment>
