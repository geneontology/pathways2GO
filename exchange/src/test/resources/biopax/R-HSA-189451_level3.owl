  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction6">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule15" />
    <bp:right rdf:resource="#SmallMolecule13" />
    <bp:right rdf:resource="#SmallMolecule17" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4.2.1.75</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UROS transforms HMB to URO3</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hydroxymethylbilane =&gt; H2O + uroporphyrinogen III</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conversion of HMB to uroporphyrinogen III</bp:name>
    <bp:xref rdf:resource="#UnificationXref97" />
    <bp:xref rdf:resource="#UnificationXref98" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cytosolic uroporphyrinogen III synthase (URO3S) catalyzes the conversion of HMB (hydroxymethylbilane) to uroporphyrinogen III, a reaction involving ring closure and intramolecular rearrangement. Uroporphyrinogen III represents a branch point for the pathways leading to formation of heme, chlorophyll and corrins. HMB is rapidly converted from a linear tetrapyrrole to the cyclic form. Deficiencies of URO3S in vivo are associated with congenital erythropoietic porphyria.</bp:comment>
    <bp:xref rdf:resource="#PublicationXref12" />
    <bp:xref rdf:resource="#PublicationXref13" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Jassal, B, D'Eustachio, P, 2007-01-24 10:19:49</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Sassa, S, 2007-01-24 10:18:36</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Jassal, B, D'Eustachio, P, 2007-01-24 10:19:49</bp:comment>
  </bp:BiochemicalReaction>
