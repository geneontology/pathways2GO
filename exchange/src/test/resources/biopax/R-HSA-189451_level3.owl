  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction19">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule40" />
    <bp:left rdf:resource="#SmallMolecule41" />
    <bp:left rdf:resource="#SmallMolecule33" />
    <bp:right rdf:resource="#SmallMolecule42" />
    <bp:right rdf:resource="#SmallMolecule43" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.5.1.141</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COX10 transforms heme to heme O</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(2E,6E)-farnesyl diphosphate + H2O + heme b =&gt; diphosphate + Fe(II)-heme o</bp:name>
    <bp:xref rdf:resource="#UnificationXref239" />
    <bp:xref rdf:resource="#UnificationXref240" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heme A and less frequently heme O function as prosthetic groups of heme-copper respiratory oxidases(Rivett et al. 2021). Mitochondrial protoheme IX farnesyltransferase (COX10) mediates the transformation of protoheme IX (heme) and farnesyl diphosphate (FAPP) to heme O (Glerum &amp; Tzagoloff 1994). COX10 is highly expressed in muscle, heart and brain (Murakami et al. 1997).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref37" />
    <bp:xref rdf:resource="#PublicationXref38" />
    <bp:xref rdf:resource="#PublicationXref39" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Jassal, B, 2013-01-22</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: D'Eustachio, P, 2013-04-15</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Matthews, Lisa, 2024-03-11</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Jassal, B, 2013-01-22</bp:comment>
  </bp:BiochemicalReaction>
