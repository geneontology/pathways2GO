  <bp:Protein rdf:ID="Protein4">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HMBS</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Porphobilinogen deaminase</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HEM3_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary2" />
    <bp:entityReference rdf:resource="#ProteinReference4" />
    <bp:feature rdf:resource="#FragmentFeature4" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 3004609</bp:comment>
    <bp:xref rdf:resource="#UnificationXref85" />
    <bp:xref rdf:resource="#UnificationXref86" />
    <bp:dataSource rdf:resource="#Provenance1" />
