  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction14">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule32" />
    <bp:left rdf:resource="#SmallMolecule31" />
    <bp:participantStoichiometry rdf:resource="#Stoichiometry27" />
    <bp:right rdf:resource="#SmallMolecule2" />
    <bp:right rdf:resource="#SmallMolecule33" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4.98.1.1</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FECH binds Fe2+ to PRIN9 to form heme</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fe(2+) + protoporphyrin IX =&gt; 2 H(+) + heme b</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ferrous iron is inserted into protoporphyrin IX to form heme</bp:name>
    <bp:xref rdf:resource="#UnificationXref179" />
    <bp:xref rdf:resource="#UnificationXref180" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ferrochelatase (FECH) catalyzes the insertion of ferrous iron into protoporphyrin IX (PRIN9) to form heme. FECH is localized on the matrix surface of the inner mitochondrial membrane and this reaction takes place within the mitochondrial matrix. The enzyme functions as a homodimer with each monomer containing a nitric oxide-sensitive 2Fe-2S cluster. Enzyme deficiency is associated with erythropoietic protoporphyria in vivo, and inhibition of ferrochelatase activity is a clinically important consequence of lead poisoning (Piomelli et al. 1987).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref25" />
    <bp:xref rdf:resource="#PublicationXref26" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Jassal, B, D'Eustachio, P, 2007-01-24 10:19:49</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Sassa, S, 2007-01-24 10:18:36</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Matthews, Lisa, 2024-03-11</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Jassal, B, D'Eustachio, P, 2007-01-24 10:19:49</bp:comment>
  </bp:BiochemicalReaction>
