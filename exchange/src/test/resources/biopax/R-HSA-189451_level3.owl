  <bp:PublicationXref rdf:ID="PublicationXref27">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">23187127</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2012</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The mitochondrial heme exporter FLVCR1b mediates erythroid differentiation</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chiabrando, Deborah</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marro, Samuele</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mercurio, Sonia</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Giorgi, Carlotta</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Petrillo, Sara</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vinchi, Francesca</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fiorito, Veronica</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fagoonee, Sharmila</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Camporeale, Annalisa</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turco, Emilia</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merlo, Giorgio R</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Silengo, Lorenzo</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Altruda, Fiorella</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pinton, Paolo</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tolosano, Emanuela</bp:author>
    <bp:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">J. Clin. Invest. 122:4569-79</bp:source>
  </bp:PublicationXref>
