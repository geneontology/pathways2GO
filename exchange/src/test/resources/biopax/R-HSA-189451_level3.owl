  <bp:PublicationXref rdf:ID="PublicationXref5">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">11032836</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2001</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The molecular mechanism of lead inhibition of human porphobilinogen synthase</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jaffe, EK</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Martins, J</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Li, J</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kervinen, J</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dunbrack RL, Jr</bp:author>
    <bp:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">J Biol Chem 276:1531-7</bp:source>
  </bp:PublicationXref>
