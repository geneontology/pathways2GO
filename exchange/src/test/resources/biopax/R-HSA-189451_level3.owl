    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABCG2 transports and transfers heme to albumin through its large extracellular loop</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desuzinges-Mandon, Elodie</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arnaud, Ophélie</bp:author>
