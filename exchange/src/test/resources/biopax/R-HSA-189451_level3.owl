    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1994</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Isolation of a human cDNA for heme A:farnesyltransferase by functional complementation of a yeast cox10 mutant</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Glerum, D M</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tzagoloff, A</bp:author>
