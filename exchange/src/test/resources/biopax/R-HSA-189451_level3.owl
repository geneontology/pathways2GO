  <bp:PublicationXref rdf:ID="PublicationXref17">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">31872</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1978</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The mitochondrial localization of coproporphyrinogen III oxidase</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grandchamp, Bernard</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phung, N</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nordmann, Y</bp:author>
    <bp:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biochem. J. 176:97-102</bp:source>
  </bp:PublicationXref>
  <bp:PathwayStep rdf:ID="PathwayStep10">
