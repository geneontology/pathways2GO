    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HMBL spontaneously transforms to URO1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hydroxymethylbilane =&gt; H2O + uroporphyrinogen I</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spontaneous conversion of HMBL to uroporphyrinogen I (URO1)</bp:name>
    <bp:xref rdf:resource="#UnificationXref102" />
    <bp:xref rdf:resource="#UnificationXref103" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hydroxymethybilane (HMBL) can spontaneously cyclize and rearrange to form uroporphyrinogen I (URO1).</bp:comment>
