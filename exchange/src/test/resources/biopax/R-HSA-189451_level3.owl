  <bp:Protein rdf:ID="Protein6">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UROD</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uroporphyrinogen III decarboxylase</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DCUP_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary2" />
    <bp:entityReference rdf:resource="#ProteinReference6" />
    <bp:feature rdf:resource="#FragmentFeature6" />
