    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALAD binds to Pb2+</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALAD octamer associates with Pb++, forming a catalytically inactive complex</bp:name>
    <bp:xref rdf:resource="#UnificationXref62" />
    <bp:xref rdf:resource="#UnificationXref63" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lead binds to ALAD enzyme displacing half the zinc ions essential for its catalytic activity and inactivating it. Lead is a major environmental toxin and this enzyme is one of its principal molecular targets (Jaffe et al. 2001).</bp:comment>
