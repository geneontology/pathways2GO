  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction2">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule6" />
    <bp:right rdf:resource="#SmallMolecule8" />
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mitochondrial dALA translocates to cytosol</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-aminolevulinate(in) = 5-aminolevulinate(out)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALA is transported from the mitochondrial matrix to the cytosol</bp:name>
    <bp:xref rdf:resource="#UnificationXref46" />
    <bp:xref rdf:resource="#UnificationXref47" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-aminolevulinate (dALA) is transported from the mitochondrial matrix to the cytosol. While indirect studies suggest that activity of the ABCB10 transporter is correlated with dALA production (Bayeva et al. 2013), biochemical studies of the purified protein indicate that dALA is not a transported substrate (Qiu et al. 2015), leaving the transporter that mediates dALA export to the cytosol and the role of ABCB10 in heme biosynthesis unknown.</bp:comment>
    <bp:xref rdf:resource="#PublicationXref3" />
    <bp:xref rdf:resource="#PublicationXref4" />
    <bp:xref rdf:resource="#RelationshipXref8" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Jassal, B, D'Eustachio, P, 2007-01-24 10:19:49</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Sassa, S, 2007-01-24 10:18:36</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Jassal, B, D'Eustachio, P, 2007-01-24 10:19:49</bp:comment>
  </bp:BiochemicalReaction>
