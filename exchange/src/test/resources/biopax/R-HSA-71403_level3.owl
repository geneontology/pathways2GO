  <bp:Complex rdf:ID="Complex14">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SUCLA2:SUCLG1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Succinyl-CoA synthetase heterodimer (ADP-forming)</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
