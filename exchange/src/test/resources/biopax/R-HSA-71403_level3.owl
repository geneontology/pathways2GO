  <bp:Protein rdf:ID="Protein17">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SUCLG2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Succinyl-CoA synthetase, betaG chain</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference14" />
    <bp:feature rdf:resource="#FragmentFeature17" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 156628</bp:comment>
