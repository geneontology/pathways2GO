  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction5">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule10" />
    <bp:left rdf:resource="#SmallMolecule19" />
    <bp:left rdf:resource="#SmallMolecule18" />
    <bp:right rdf:resource="#SmallMolecule17" />
    <bp:right rdf:resource="#SmallMolecule6" />
    <bp:right rdf:resource="#SmallMolecule13" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.6.1.1</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NNT dimer transfers proton from NADPH to NAD+</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">H(+)(in) + NAD(+) + NADPH = H(+)(out) + NADH + NADP(+)</bp:name>
    <bp:xref rdf:resource="#UnificationXref117" />
    <bp:xref rdf:resource="#UnificationXref118" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NNT (nicotinamide nucleotide transhydrogenase) associated with the inner mitochondrial membrane catalyzes the reaction of mitochondrial NADPH and NAD+ to form NADP+ and NADH. The reaction is coupled to the translocation of a proton across the inner mitochondrial membrane into the mitochondrial matrix (Arkblad et al., 1996; White et al., 2000). The active form of NNT is inferred to be a homodimer based on the known structure of its bovine homolog (Yamaguchi &amp; Hatefi, 1991) and the structure of the ovine homolog (Kampjut &amp; Sazanow, 2019).

Mutations in NNT can lead to glucocorticoid deficiency (GCCD4; MIM:614736; reviewed in Francisco et al., 2021).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref22" />
    <bp:xref rdf:resource="#PublicationXref23" />
    <bp:xref rdf:resource="#PublicationXref24" />
    <bp:xref rdf:resource="#PublicationXref25" />
    <bp:xref rdf:resource="#PublicationXref26" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: D'Eustachio, P, 2009-12-26</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hill, David P, 2024-02-15</bp:comment>
  </bp:BiochemicalReaction>
