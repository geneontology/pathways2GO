  <bp:Protein rdf:ID="Protein28">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CSKMT</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CS-KMT</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">METTL12</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Citrate synthase-lysyl)-methyltransferase</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference22" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 9854310</bp:comment>
    <bp:xref rdf:resource="#UnificationXref301" />
    <bp:xref rdf:resource="#UnificationXref302" />
