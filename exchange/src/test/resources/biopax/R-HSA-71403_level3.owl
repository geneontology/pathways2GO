  <bp:Protein rdf:ID="Protein33">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SDA5</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SDHAF2</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
