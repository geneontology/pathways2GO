  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction20">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#Protein34" />
    <bp:left rdf:resource="#Protein19" />
    <bp:right rdf:resource="#Complex31" />
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SDHAF4 binds to FAD-SDHA</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref379" />
    <bp:xref rdf:resource="#UnificationXref380" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Succinate dehydrogenase assembly factor 4 (SDHAF4) binds to flavinylated SDH complex subunit A (SDHA), stabilizing it before assembly into the SDH complex. The process has been shown in yeast and mice (Van Vranken et al., 2014; Wang et al., 2022).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref87" />
    <bp:xref rdf:resource="#PublicationXref88" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Stephan, Ralf, 2023-11-28</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hill, David P, 2024-02-15</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: D'Eustachio, Peter, 2024-02-15</bp:comment>
  </bp:BiochemicalReaction>
  <bp:Protein rdf:ID="Protein34">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SDHAF4</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference27" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 9854972</bp:comment>
    <bp:xref rdf:resource="#UnificationXref375" />
    <bp:xref rdf:resource="#UnificationXref376" />
