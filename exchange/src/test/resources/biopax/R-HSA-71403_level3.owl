    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2021</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACO2 clinicobiological dataset with extensive phenotype ontology annotation</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Guehlouz, Khadidja</bp:author>
