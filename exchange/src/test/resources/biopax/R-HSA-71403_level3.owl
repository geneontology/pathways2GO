  <bp:Protein rdf:ID="Protein38">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SDHAF1</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference30" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 9854988</bp:comment>
    <bp:xref rdf:resource="#UnificationXref397" />
    <bp:xref rdf:resource="#UnificationXref398" />
    <bp:dataSource rdf:resource="#Provenance1" />
