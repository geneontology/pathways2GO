  <bp:Protein rdf:ID="Protein42">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NFS1_HUMAN</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PXLP-K258-NFS1-1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NFS1, mitochondrial (ISCS)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cysteine desulfurase, mitochondrial</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NSF1 isoform 1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference34" />
    <bp:feature rdf:resource="#ModificationFeature10" />
    <bp:feature rdf:resource="#FragmentFeature37" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1362396</bp:comment>
