  <bp:Protein rdf:ID="Protein13">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MRPS36</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">28S ribosomal protein S36, mitochondrial</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RT36_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference11" />
    <bp:feature rdf:resource="#FragmentFeature13" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 5368206</bp:comment>
    <bp:xref rdf:resource="#UnificationXref152" />
