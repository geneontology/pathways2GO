  <bp:Protein rdf:ID="Protein5">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IDH3B</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isocitrate dehydrogenase 3 (NAD+) beta</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Isocitrate dehydrogenase (NAD) subunit beta, mitochondrial precursor</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Isocitric dehydrogenase</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NAD+-specific ICDH</bp:name>
