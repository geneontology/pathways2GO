    <bp:organism rdf:resource="#BioSource1" />
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maturation of TCA enzymes and regulation of TCA cycle</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref433" />
    <bp:xref rdf:resource="#UnificationXref434" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Citrate-synthase)-lysyl-methyltransferase (CSKMT, METTL12) transfers three methyl groups from S-adenosylmethionine (SAM) to lysine-395 of citrate synthase (CS). The expression of CSKMT is low or absent in many normal organ tissues, but the trimethylated form is predominant in most cell lines tested. The modification is evolutionarily conserved, with contradicting reports on the activity of modified CS, while the effect on the whole CS/ACO2 metabolon was not investigated. Oxalocetate inhibits methyltransferase activity (Malecki et al., 2017; Rhein et al., 2017; reviewed in Qi et al., 2023).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref96" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Stephan, Ralf, 2023-11-25</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hill, David P, 2024-02-15</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: D'Eustachio, Peter, 2024-02-15</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Stephan, Ralf, 2024-05-21</bp:comment>
  </bp:Pathway>
  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction14">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:participantStoichiometry rdf:resource="#Stoichiometry48" />
    <bp:left rdf:resource="#SmallMolecule36" />
    <bp:left rdf:resource="#Complex23" />
    <bp:right rdf:resource="#Complex27" />
    <bp:participantStoichiometry rdf:resource="#Stoichiometry52" />
    <bp:right rdf:resource="#SmallMolecule37" />
    <bp:participantStoichiometry rdf:resource="#Stoichiometry53" />
    <bp:right rdf:resource="#SmallMolecule6" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.1.1</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CSKMT methylates Citrate Synthase</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref303" />
    <bp:xref rdf:resource="#UnificationXref304" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Citrate-synthase)-lysyl-methyltransferase (CSKMT, METTL12) transfers three methyl groups from S-adenosylmethionine (SAM) to lysine-395 of citrate synthase (CS). The modification is evolutionarily conserved and attenuates the activity of CS by about 30% in vitro. The trimethylated form is predominant in most cell lines tested. Oxaloacetate and S-adenosylhomocysteine inhibit methyltransferase activity (Malecki et al., 2017; Rhein et al., 2017; reviewed in Qi et al., 2023).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref72" />
    <bp:xref rdf:resource="#PublicationXref2" />
    <bp:xref rdf:resource="#PublicationXref73" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Stephan, Ralf, 2023-11-25</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hill, David P, 2024-02-16</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: D'Eustachio, Peter, 2024-02-15</bp:comment>
  </bp:BiochemicalReaction>
