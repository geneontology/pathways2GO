  <bp:Protein rdf:ID="Protein16">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SUCLA2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Succinyl-CoA synthetase, betaA chain</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference13" />
    <bp:feature rdf:resource="#FragmentFeature16" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 156624</bp:comment>
    <bp:xref rdf:resource="#UnificationXref184" />
