  <bp:Protein rdf:ID="Protein4">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IDH3A</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isocitrate dehydrogenase 3 (NAD+) alpha</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Isocitrate dehydrogenase (NAD) subunit alpha, mitochondrial precursor</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Isocitric dehydrogenase</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NAD+-specific ICDH</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference4" />
