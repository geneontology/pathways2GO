  <bp:Protein rdf:ID="Protein31">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SIRT3</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SIRT3(?-399)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NAD-dependent deacetylase sirtuin-3, mitochondrial</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SIRT3_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference25" />
