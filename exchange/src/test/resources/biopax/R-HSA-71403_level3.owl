  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction3">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule7" />
    <bp:left rdf:resource="#SmallMolecule10" />
    <bp:right rdf:resource="#SmallMolecule11" />
    <bp:right rdf:resource="#SmallMolecule12" />
    <bp:right rdf:resource="#SmallMolecule13" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.1.1.41</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IDH3 complex decarboxylates isocitrate</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D-threo-isocitrate + NAD(+) =&gt; 2-oxoglutarate + CO2 + NADH</bp:name>
    <bp:xref rdf:resource="#UnificationXref78" />
    <bp:xref rdf:resource="#UnificationXref79" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mitochondrial isocitrate dehydrogenase IDH3 catalyzes the irreversible reaction of isocitrate and NAD+ to form alpha-ketoglutarate, CO2, and NADH. The enzyme is a heterooctamer containing two copies of a heterotetramer of two IDH3A, one IDH3B, one IDH3G, and two Mn++ (PDB 7CE3; Sun et al., 2020; Dange and Colman, 2010). It is activated by ADP (Soundar et al., 2003, 2006; Bzymek and Colman, 2007) and inhibited by NADH and high concentrations of ATP (Cohen &amp; Colman, 1972; Sun et al., 2020). This is the first of four oxidation reactions in the citric acid cycle and the first decarboxylation.&lt;br&gt;&lt;br&gt;Mutations in the IDH3A, IDH3B gene can cause retinitis pigmentosa (RP46; MIM:612572; RP90; MIM:619007) (Hartong et al., 2008).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref10" />
    <bp:xref rdf:resource="#PublicationXref11" />
    <bp:xref rdf:resource="#PublicationXref12" />
    <bp:xref rdf:resource="#PublicationXref13" />
    <bp:xref rdf:resource="#PublicationXref14" />
    <bp:xref rdf:resource="#PublicationXref15" />
    <bp:xref rdf:resource="#PublicationXref16" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hill, David P, 2024-02-15</bp:comment>
  </bp:BiochemicalReaction>
