    <bp:left rdf:resource="#SmallMolecule31" />
    <bp:left rdf:resource="#SmallMolecule2" />
    <bp:right rdf:resource="#SmallMolecule35" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4.2.1.2</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fumarate + H2O =&gt; (S)-malate</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FH tetramer hydrates fumarate to L-malate</bp:name>
    <bp:xref rdf:resource="#UnificationXref266" />
    <bp:xref rdf:resource="#UnificationXref267" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mitochondrial fumarate hydratase (FH) tetramer catalyzes the reversible reaction of fumarate and water to form malate, the seventh step of the TCA cycle (Ajalla Aleixo et al., 2019; Wang et al., 2020). Mutations in the FH gene can lead to fumarase deficiency (FMRD, MIM:606812) or to leiomyomatosis and renal cell cancer (HLRCC, MIM:150800) (Bourgeron et al., 1994; reviewed by Giallongo et al, 2023).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref63" />
    <bp:xref rdf:resource="#PublicationXref64" />
    <bp:xref rdf:resource="#PublicationXref65" />
    <bp:xref rdf:resource="#PublicationXref66" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hill, David P, 2024-02-15</bp:comment>
  </bp:BiochemicalReaction>
