    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2014</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SDHAF4 promotes mitochondrial succinate dehydrogenase activity and prevents neurodegeneration</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Van Vranken, Jonathan G</bp:author>
