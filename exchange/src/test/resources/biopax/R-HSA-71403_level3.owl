  <bp:Protein rdf:ID="Protein40">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISCU2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISCU-1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISCU, mitochondrial</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Iron-sulfur cluster assembly enzyme ISCU, mitochondrial</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISCU_HUMAN</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISCU isoform 1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference32" />
    <bp:feature rdf:resource="#FragmentFeature35" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 1362391</bp:comment>
