  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction16">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#Complex28" />
    <bp:left rdf:resource="#Complex3" />
    <bp:right rdf:resource="#Complex2" />
    <bp:right rdf:resource="#SmallMolecule46" />
    <bp:right rdf:resource="#Protein29" />
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frataxin transfers Fe2+ to ACO2</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref340" />
    <bp:xref rdf:resource="#UnificationXref341" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frataxin (FXN) is an iron chaperone that acts as a protein partner of ACO2 not only during Fe–S maturation but also during the repairing of inactivated [3Fe–4S]+-ACO2. It donates one Fe atom to reactivate ACO2 with a full [4Fe-4S](2+) cluster (Bulteau et al., 2004; Mansilla et al., 2023). Mutations in FXN can lead to Friedreich ataxia (FXAD, MIM:229300; see e.g. Cossee et al., 1999).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref77" />
    <bp:xref rdf:resource="#PublicationXref78" />
    <bp:xref rdf:resource="#PublicationXref79" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Stephan, Ralf, 2023-11-26</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hill, David P, 2024-02-15</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: D'Eustachio, Peter, 2024-02-15</bp:comment>
  </bp:BiochemicalReaction>
