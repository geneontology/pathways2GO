  <bp:Protein rdf:ID="Protein22">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAP1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heat shock protein 75 kDa, mitochondrial</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAP1_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
