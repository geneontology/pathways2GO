  <bp:Protein rdf:ID="Protein1">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">citrate synthase</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N6,N6,N6-trimethyl-K395-CS</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Citrate synthase, mitochondrial precursor</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference1" />
    <bp:feature rdf:resource="#ModificationFeature1" />
    <bp:feature rdf:resource="#FragmentFeature1" />
