    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deficiency of the ADP-forming succinyl-CoA synthase activity is associated with encephalomyopathy and mitochondrial DNA depletion</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elpeleg, O</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Miller, C</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hershkovitz, E</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bitner-Glindzicz, M</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bondi-Rubinstein, G</bp:author>
