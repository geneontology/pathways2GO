    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1993</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein assembly-disassembly pathway in vitro that may correspond to sequential steps of synaptic vesicle docking, activation, and fusion</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Söllner, Thomas</bp:author>
