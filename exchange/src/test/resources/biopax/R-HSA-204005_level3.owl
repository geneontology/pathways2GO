  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein22">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEC24A</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protein transport protein Sec24A</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S24A_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference7" />
    <bp:feature rdf:resource="#FragmentFeature20" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 203978</bp:comment>
    <bp:xref rdf:resource="#UnificationXref80" />
    <bp:xref rdf:resource="#UnificationXref81" />
