    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNAREs--engines for membrane fusion</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jahn, Reinhard</bp:author>
