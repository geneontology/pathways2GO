  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein2">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PREB</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sec12</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prolactin regulatory element-binding protein</bp:name>
