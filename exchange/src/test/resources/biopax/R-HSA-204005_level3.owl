  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein45">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRIA1</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference26" />
    <bp:feature rdf:resource="#FragmentFeature39" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 5689460</bp:comment>
    <bp:xref rdf:resource="#UnificationXref195" />
