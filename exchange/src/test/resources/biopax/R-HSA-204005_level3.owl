  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein138">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAPPC6B</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference53" />
    <bp:feature rdf:resource="#FragmentFeature117" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 5685735</bp:comment>
