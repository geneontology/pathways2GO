  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein210">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NSF</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vesicle-fusing ATPase</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NSF_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference67" />
