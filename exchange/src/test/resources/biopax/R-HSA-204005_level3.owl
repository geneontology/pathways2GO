  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein129">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAPPC9</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NIBP</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAPP2</bp:name>
