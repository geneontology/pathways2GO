  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein32">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alpha1-antitrypsin</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Glc)3(GlcNAc)2(Man)9-SERPINA1</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary2" />
    <bp:entityReference rdf:resource="#ProteinReference15" />
