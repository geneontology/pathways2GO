  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein50">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">p23</bp:displayName>
