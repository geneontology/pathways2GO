  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein18">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEC24C</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protein transport protein Sec24C</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S24C_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference6" />
