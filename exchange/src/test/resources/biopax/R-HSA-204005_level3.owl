  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein53">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPI-CD59</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference32" />
    <bp:feature rdf:resource="#ModificationFeature10" />
