  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein30">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cathepsin C</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(Glc)3(GlcNAc)2(Man)9-CTSC</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary2" />
