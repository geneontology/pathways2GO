  <bp:BiochemicalReaction xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="BiochemicalReaction18">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#Complex32" />
    <bp:left rdf:resource="#Complex51" />
    <bp:left rdf:resource="#Complex52" />
    <bp:right rdf:resource="#Complex53" />
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COPII coat binds TRAPPCII and RAB1:GDP</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref535" />
    <bp:xref rdf:resource="#UnificationXref536" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAPPC is a multi-subunit tethering complex that facilitates ER-to-Golgi traffic (reviewed in Barrowman et al, 2010; Brunet and Sacher, 2014).  TRAPPC is a guanine-nucleotide exchange factor for RAB1 and is recruited to ER-derived vesicles by virtue of an interaction between the TRAPPC component TRAPPC3 and the coat protein SEC23 (Cai et al, 2007; Lord et al, 2011).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref53" />
    <bp:xref rdf:resource="#PublicationXref54" />
    <bp:xref rdf:resource="#PublicationXref55" />
    <bp:xref rdf:resource="#PublicationXref56" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Rothfels, Karen, 2015-03-16</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Gillespie, Marc E, 2015-08-17</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Rothfels, Karen, 2015-04-17</bp:comment>
  </bp:BiochemicalReaction>
