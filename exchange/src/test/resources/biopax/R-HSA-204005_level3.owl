  </bp:PublicationXref>
  <bp:PublicationXref xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="PublicationXref79">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16912714</bp:id>
