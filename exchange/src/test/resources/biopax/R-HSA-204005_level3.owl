  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein130">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEDL</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAPPC2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAPP1</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAPP2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAPP3</bp:name>
