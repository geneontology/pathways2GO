  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein63">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEC16A</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference36" />
    <bp:feature rdf:resource="#FragmentFeature53" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 5685728</bp:comment>
    <bp:xref rdf:resource="#UnificationXref285" />
