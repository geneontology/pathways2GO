    <bp:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell 75:409-18</bp:source>
  </bp:PublicationXref>
  <bp:PublicationXref xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="PublicationXref78">
