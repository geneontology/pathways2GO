  <bp:PublicationXref xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="PublicationXref34">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">17316621</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2007</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mechanisms of COPII vesicle formation and protein sorting</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sato, K</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nakano, A</bp:author>
    <bp:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FEBS Lett 581:2076-82</bp:source>
  </bp:PublicationXref>
  <bp:PathwayStep xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="PathwayStep15">
