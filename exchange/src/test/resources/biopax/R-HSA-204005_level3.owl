    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1996</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sec18p (NSF)-driven release of Sec17p (alpha-SNAP) can precede docking and fusion of yeast vacuoles</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mayer, Andreas</bp:author>
