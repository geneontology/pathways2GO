  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein68">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEC13</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEC13-related protein</bp:name>
