  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein140">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RAB1</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RAB1A</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ras-related protein Rab-1A</bp:name>
