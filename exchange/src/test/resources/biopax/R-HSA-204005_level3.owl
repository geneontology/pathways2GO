  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein61">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TFG</bp:displayName>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference34" />
    <bp:feature rdf:resource="#FragmentFeature51" />
