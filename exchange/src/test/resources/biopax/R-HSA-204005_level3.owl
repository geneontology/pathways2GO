  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein66">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SEC31A</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protein transport protein Sec31A</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SC31A_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary3" />
    <bp:entityReference rdf:resource="#ProteinReference38" />
    <bp:feature rdf:resource="#FragmentFeature55" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 203983</bp:comment>
