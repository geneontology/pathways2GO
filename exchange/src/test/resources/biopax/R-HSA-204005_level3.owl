    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBC1 domain family member 20</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary6" />
    <bp:entityReference rdf:resource="#ProteinReference71" />
    <bp:feature rdf:resource="#FragmentFeature181" />
