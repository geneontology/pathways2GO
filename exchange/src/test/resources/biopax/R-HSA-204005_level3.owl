  <bp:Protein xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="Protein54">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SAR1B</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SAR1B GTP-binding protein</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SARA2</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference33" />
    <bp:feature rdf:resource="#FragmentFeature46" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 203995</bp:comment>
    <bp:xref rdf:resource="#UnificationXref237" />
