  <bp:BiochemicalReaction xmlns:bp="http://www.biopax.org/release/biopax-level3.owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:ID="BiochemicalReaction14">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#Complex24" />
    <bp:right rdf:resource="#Complex26" />
    <bp:right rdf:resource="#SmallMolecule6" />
    <bp:right rdf:resource="#Complex21" />
    <bp:right rdf:resource="#Complex23" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.6.5.4</bp:eCNumber>
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.6.5.3</bp:eCNumber>
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.6.5.2</bp:eCNumber>
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.6.5.1</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loss of SAR1B GTPase</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref274" />
    <bp:xref rdf:resource="#UnificationXref275" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sar1p-GTP hydrolysis is increased 15-30-fold by Sec23p. Sar1p-GDP is released as a result of this hydrolysis and used in further vesicle sculpting cycles. Sar1p-GTP hydrolysis occurs at two critical points during the cycle, first (as represented here) as a proofreading step, insuring that the cargo is loaded. Later in the cycle Sar1p-GTP hydrolysis triggers the uncoating of the budded vesicle.</bp:comment>
    <bp:xref rdf:resource="#PublicationXref27" />
    <bp:xref rdf:resource="#PublicationXref34" />
    <bp:xref rdf:resource="#PublicationXref28" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Gillespie, ME, 2007-07-13 20:42:29</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Gagneux, P, 2010-11-18</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Gillespie, ME, 2007-11-21 20:48:45</bp:comment>
  </bp:BiochemicalReaction>
