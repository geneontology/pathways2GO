    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2013</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sit4p/PP6 regulates ER-to-Golgi traffic by controlling the dephosphorylation of COPII coat subunits</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bhandari, Deepali</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zhang, Jinzhong</bp:author>
