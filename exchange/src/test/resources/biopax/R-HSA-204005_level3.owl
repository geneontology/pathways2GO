    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBC1D20 binds RAB1:GTP</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref800" />
    <bp:xref rdf:resource="#UnificationXref801" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBC1D20 was identified as a GTPase activating protein for RAB1 that stimulates basal GTP hydrolysis by more than 5 orders of magnitude (Haas et al, 2007; Fuchs et al, 2007).</bp:comment>
