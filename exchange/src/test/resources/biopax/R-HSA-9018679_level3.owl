  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction8">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule13" />
    <bp:left rdf:resource="#SmallMolecule19" />
    <bp:right rdf:resource="#SmallMolecule20" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3.3.2.10</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LTA4H:Zn2+ hydrolyses 5S,6S-epoxy-18(S)-HEPE to 18(S)-RvE1</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref108" />
    <bp:xref rdf:resource="#UnificationXref109" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leukotriene A4 hydrolase (LTA4H) is a monomeric, soluble enzyme that uses a Zn2+ cofactor to catalyse the hydrolysis of the allylic epoxide leukotriene A4 (LTA4) (McGee &amp; Fitzpatrick 1985). LTA4H can also catalyse the hydrolysis of 5S,6S-epoxy-18(S)-HEPE to the 18(S) stereoisomer of resolvin E1 (18(S)-RvE1) (Oh et al. 2011). The E-resolvins are anti-inflammatory, pro-resolving, and non-phlogistic (that is, they mediate the clearance of leukocytes without eliciting an inflammatory response) (Serhan et al. 2008).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref17" />
    <bp:xref rdf:resource="#PublicationXref18" />
    <bp:xref rdf:resource="#PublicationXref4" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Jassal, Bijay, 2017-09-05</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hansen, Trond Vidar, 2018-02-21</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Jassal, Bijay, 2017-09-05</bp:comment>
  </bp:BiochemicalReaction>
