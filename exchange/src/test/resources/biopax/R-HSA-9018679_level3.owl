    <bp:left rdf:resource="#SmallMolecule5" />
    <bp:participantStoichiometry rdf:resource="#Stoichiometry8" />
    <bp:left rdf:resource="#SmallMolecule10" />
    <bp:right rdf:resource="#SmallMolecule12" />
    <bp:right rdf:resource="#SmallMolecule13" />
    <bp:right rdf:resource="#SmallMolecule30" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.11.1.12</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPX4-2 reduces 18(R)-HpEPE to 18(R)-HEPE</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref145" />
    <bp:xref rdf:resource="#UnificationXref146" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In PMNs, cytosolic phospholipid hydroperoxide glutathione peroxidase (GPX4 isoform 2, GPX4-2) (Yagi et al. 1996) is a likely candidate for the reduction of organic hydroperoxides such as 18(R)-HpEPE to 18(R)-hydroxyeicosapentaenoic acid (18(R)-HEPE) (Han et al. 2013) using glutathione (GSH) as an electron donor (Brigelius-Flohe &amp; Maiorino 2013).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref9" />
    <bp:xref rdf:resource="#PublicationXref10" />
    <bp:xref rdf:resource="#PublicationXref11" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Jassal, Bijay, 2017-09-05</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hansen, Trond Vidar, 2018-02-21</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Jassal, Bijay, 2017-09-05</bp:comment>
  </bp:BiochemicalReaction>
