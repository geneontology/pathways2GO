  <bp:Protein rdf:ID="Protein7">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPGD</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">15-hydroxyprostaglandin dehydrogenase (NAD+)</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PGDH_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference6" />
    <bp:feature rdf:resource="#FragmentFeature7" />
