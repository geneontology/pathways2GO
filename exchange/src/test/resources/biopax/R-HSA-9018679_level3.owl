  <bp:Protein rdf:ID="Protein4">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALOX15</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arachidonate 15-lipoxygenase</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LOX15_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference3" />
    <bp:feature rdf:resource="#FragmentFeature4" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 2142838</bp:comment>
    <bp:xref rdf:resource="#UnificationXref67" />
