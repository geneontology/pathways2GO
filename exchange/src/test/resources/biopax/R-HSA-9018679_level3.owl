  <bp:PublicationXref rdf:ID="PublicationXref20">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">18292578</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2008</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resolvin E1 metabolome in local inactivation during inflammation-resolution</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hong, Song</bp:author>
