  </bp:PublicationXref>
  <bp:PublicationXref rdf:ID="PublicationXref11">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8605014</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1996</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expression of human phospholipid hydroperoxide glutathione peroxidase gene for protection of host cells from lipid hydroperoxide-mediated injury</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yagi, K</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Komura, S</bp:author>
