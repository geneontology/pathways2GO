  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction7">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule15" />
    <bp:left rdf:resource="#SmallMolecule2" />
    <bp:right rdf:resource="#SmallMolecule19" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.13</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALOX5 oxidises 5(S)-Hp-18(S)-HEPE to 5S,6S-epoxy-18(S)-HEPE</bp:displayName>
    <bp:xref rdf:resource="#UnificationXref95" />
    <bp:xref rdf:resource="#UnificationXref96" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In neutrophils, 5-lipoxygenase (ALOX5) can mediate the insertion of molecular oxygen into 5(S)-hydroperoxy-18(S)-hydroxyeicosapentaenoic acid (5(S)-Hp-18(S)-HEPE) to form 5S,6S-epoxy-18(S)-HEPE which is essential for 18(S)-resolvin E1 biosynthesis (Tjonahen et al. 2006, Oh et al. 2012).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref14" />
    <bp:xref rdf:resource="#PublicationXref15" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Jassal, Bijay, 2017-09-05</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hansen, Trond Vidar, 2018-02-21</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Jassal, Bijay, 2017-09-05</bp:comment>
  </bp:BiochemicalReaction>
  <bp:SmallMolecule rdf:ID="SmallMolecule19">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5(S)6-epoxy-18S-HEPE</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5S,6S-epoxy-18(S)-HEPE</bp:name>
