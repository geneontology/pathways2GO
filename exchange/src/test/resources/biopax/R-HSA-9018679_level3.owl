  <bp:Protein rdf:ID="Protein1">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ac-PTGS2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O-acetyl-L-serine-PTGS2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acetyl-PTGS2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cyclooxygenase -2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ac-COX-2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ac-Prostaglandin-endoperoxide synthase 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ac-Prostaglandin H2 synthase 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ac-PGH synthase 2</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ac-PGHS-2</bp:name>
