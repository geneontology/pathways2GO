  <bp:PublicationXref rdf:ID="PublicationXref13">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">22275352</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2012</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identification and structure determination of novel anti-inflammatory mediator resolvin E3, 17,18-dihydroxyeicosapentaenoic acid</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Isobe, Yosuke</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arita, Makoto</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matsueda, Shinnosuke</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Iwamoto, Ryo</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fujihara, Takuji</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nakanishi, Hiroki</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taguchi, Ryo</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Masuda, Koji</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sasaki, Kenji</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Urabe, Daisuke</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inoue, Masayuki</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arai, Hiroyuki</bp:author>
    <bp:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">J. Biol. Chem. 287:10525-34</bp:source>
  </bp:PublicationXref>
