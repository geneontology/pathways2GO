  <bp:PublicationXref rdf:ID="PublicationXref16">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">19164464</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2009</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Substrate selectivity of 5-hydroxyeicosanoid dehydrogenase and its inhibition by 5-hydroxy-Delta6-long-chain fatty acids</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patel, Pranav</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cossette, Chantal</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anumolu, Jaganmohan R</bp:author>
