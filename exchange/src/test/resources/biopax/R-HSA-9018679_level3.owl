    <bp:year rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2013</bp:year>
    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stereochemical assignment and anti-inflammatory properties of the omega-3 lipid mediator resolvin E3</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Isobe, Yosuke</bp:author>
