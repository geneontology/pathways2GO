    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5(S)6-epoxy-18(S)-HEPE</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5,6-epoxy,18S-hydroxy-eicosapentaenoic acid</bp:name>
