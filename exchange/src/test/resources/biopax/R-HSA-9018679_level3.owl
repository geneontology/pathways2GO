    <bp:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Glutathione peroxidases</bp:title>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brigelius-Flohé, Regina</bp:author>
