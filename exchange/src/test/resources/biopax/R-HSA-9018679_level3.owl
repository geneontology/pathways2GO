  <bp:BiochemicalReaction rdf:ID="BiochemicalReaction14">
    <bp:conversionDirection rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LEFT-TO-RIGHT</bp:conversionDirection>
    <bp:left rdf:resource="#SmallMolecule32" />
    <bp:left rdf:resource="#SmallMolecule16" />
    <bp:right rdf:resource="#SmallMolecule33" />
    <bp:right rdf:resource="#SmallMolecule13" />
    <bp:right rdf:resource="#SmallMolecule17" />
    <bp:eCNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.6.99.1</bp:eCNumber>
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5-HEDH dehydrogenates 5(S)-Hp-18(R)-HEPE to 18(R)-RvE2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(5S)-hydroperoxy-(18R)-hydroxy-(6E,8Z,11Z,14Z,16E)-eicosapentaenoate + AH2 =&gt; A + H2O + resolvin E2</bp:name>
    <bp:xref rdf:resource="#UnificationXref160" />
    <bp:xref rdf:resource="#UnificationXref161" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An unknown dehydrogenase reduces 5(S)-hydroperoxy-18(R)-hydroxyeicosapentaenoic acid (5(S)-Hp-18(R)-HEPE) into the 18(R) stereoisomer of resolvin E2 (18(R)-RvE2). The unknown enzyme may be 5-hydroxyeicosanoid dehydrogenase (5-HEDH) or one similar to this (Patel et al. 2009). Human neutrophils biosynthesise RvE2 in greater amounts than RvE1, suggesting a significant role for RvE2 (Tjonahen et al. 2006, Oh et al. 2012).</bp:comment>
    <bp:xref rdf:resource="#PublicationXref14" />
    <bp:xref rdf:resource="#PublicationXref16" />
    <bp:xref rdf:resource="#PublicationXref15" />
    <bp:dataSource rdf:resource="#Provenance1" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authored: Jassal, Bijay, 2017-09-05</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hansen, Trond Vidar, 2018-02-21</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewed: Hill, David P, 2024-08-02</bp:comment>
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edited: Jassal, Bijay, 2017-09-05</bp:comment>
  </bp:BiochemicalReaction>
