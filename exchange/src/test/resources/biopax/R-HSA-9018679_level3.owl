    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grant, Gail E</bp:author>
    <bp:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rokach, Joshua</bp:author>
