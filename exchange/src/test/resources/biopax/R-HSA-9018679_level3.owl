  <bp:PublicationXref rdf:ID="PublicationXref10">
    <bp:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">23201771</bp:id>
    <bp:db rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pubmed</bp:db>
