  <bp:Protein rdf:ID="Protein3">
    <bp:displayName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPX4-2</bp:displayName>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phospholipid hydroperoxide glutathione peroxidase, cytosolic</bp:name>
    <bp:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPX4_HUMAN</bp:name>
    <bp:cellularLocation rdf:resource="#CellularLocationVocabulary1" />
    <bp:entityReference rdf:resource="#ProteinReference2" />
    <bp:feature rdf:resource="#FragmentFeature3" />
    <bp:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactome DB_ID: 9020572</bp:comment>
    <bp:xref rdf:resource="#UnificationXref59" />
